generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TodoStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TimelineEventType {
  CREATED
  UPDATED
  STATUS_CHANGED
  TIMELINE_UPDATED
  IMAGE_UPDATED
  SUBTODO_ADDED
  SUBTODO_STATUS_CHANGED
}

model User {
  id             Int            @id @default(autoincrement())
  email          String         @unique
  passwordHash   String
  name           String?
  todos          Todo[]
  timelineEvents TodoTimeline[] @relation("UserTimelineEvents")
  routines       Routine[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Todo {
  id             Int            @id @default(autoincrement())
  title          String
  description    String?
  imageUrl       String?
  startDate      DateTime?
  endDate        DateTime?
  status         TodoStatus     @default(TODO)
  userId         Int
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  parentId       Int?
  parent         Todo?          @relation("SubTodos", fields: [parentId], references: [id], onDelete: Cascade)
  subtodos       Todo[]         @relation("SubTodos")
  timelineEvents TodoTimeline[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId])
  @@index([parentId])
}

model TodoTimeline {
  id          Int               @id @default(autoincrement())
  todoId      Int
  todo        Todo              @relation(fields: [todoId], references: [id], onDelete: Cascade)
  type        TimelineEventType
  message     String
  actorUserId Int?
  actor       User?             @relation("UserTimelineEvents", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())

  @@index([todoId])
}

/// A recurring habit/routine (e.g. "Workout" every Mon/Wed/Fri).
model Routine {
  id          Int                 @id @default(autoincrement())
  userId      Int
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  emoji       String?
  /// Days the routine is scheduled: 0 = Sunday ... 6 = Saturday.
  daysOfWeek  Int[]               @default([0, 1, 2, 3, 4, 5, 6])
  /// Optional reminder time in "HH:MM" (24h).
  timeOfDay   String?
  isActive    Boolean             @default(true)
  completions RoutineCompletion[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
}

/// One check-in for a routine on a calendar day (user's local date).
model RoutineCompletion {
  id        Int      @id @default(autoincrement())
  routineId Int
  routine   Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  /// Local calendar date "YYYY-MM-DD" chosen by the client.
  date      String
  createdAt DateTime @default(now())

  @@unique([routineId, date])
  @@index([routineId])
}
